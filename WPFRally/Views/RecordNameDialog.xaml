<UserControl x:Class="WPFRally.Views.RecordNameDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource LiveGradient}">
    <Grid>
        <Border Background="{DynamicResource LiveGradient}" 
                CornerRadius="15" 
                Width="400" 
                Height="240"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                BorderBrush="#3498DB" 
                BorderThickness="2">
            <StackPanel Margin="-2,20,-2,20">
                <TextBlock Text="НОВЫЙ РЕКОРД!" 
                           Style="{StaticResource TitleText}" 
                           FontSize="24" 
                           Margin="0,0,0,15"/>
                <TextBlock Text="Введите три буквы:"  Style="{StaticResource NormalText}" FontSize="16" Foreground="White" Margin="0,0,0,20" RenderTransformOrigin="0.511,-0.239" />
                <TextBox x:Name="InitialsBox" MaxLength="3" FontSize="20" HorizontalAlignment="Center" Width="120"
         TextAlignment="Center" Margin="0,0,0,20" Background="#ECF0F1" Foreground="#2C3E50" BorderBrush="#3498DB" BorderThickness="2" UndoLimit="3" TextChanged="OnTextChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="35,0">
                    <Button Content="Сохранить" Width="150" Margin="10" Click="Save_Click" Background="#27AE60"/>
                    <Button Content="Отмена" Width="150" Margin="10" Click="Cancel_Click" Background="#E74C3C"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>