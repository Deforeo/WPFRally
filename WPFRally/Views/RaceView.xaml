<UserControl x:Class="WPFRally.Views.RaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Focusable="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"

             >
    <Grid>
        <skia:SKElement Name="skiaElement" PaintSurface="OnPaintSurface"/>
        <ContentControl x:Name="PauseOverlayContainer" Visibility="Collapsed"/>
        <ContentControl x:Name="CountdownOverlayContainer" Visibility="Collapsed"/>
    </Grid>
</UserControl>