<UserControl x:Class="WPFRally.Views.CarGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MenuBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="АВТОМОБИЛИ" Style="{StaticResource TitleText}" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <WrapPanel>
                <ItemsControl ItemsSource="{Binding Cars}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="15" Padding="10" Background="#2C3E50" CornerRadius="10" BorderBrush="#3498DB" BorderThickness="1">
                                <StackPanel>
                                    <Image Source="{Binding Thumbnail}" Width="200" Height="120" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="18" Foreground="White" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Назад" Command="{Binding BackCommand}" Width="150" Margin="10" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>