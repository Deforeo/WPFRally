<UserControl x:Class="WPFRally.Views.PauseOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#AA000000">
    <Grid>
        <Border Background="#2C3E50" CornerRadius="10" Width="300" Height="220" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="20">
                <Button Content="Продолжить" Height="50" Click="Resume_Click" Margin="5"/>
                <Button Content="Заново" Height="50" Click="Restart_Click" Margin="5"/>
                <Button Content="Выйти в меню" Height="50" Click="Exit_Click" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
