<UserControl x:Class="WPFRally.Views.MenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource MenuBackground}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="RALLY GAME" Style="{StaticResource TitleText}"/>
        <Button Content="▶ ИГРАТЬ" Width="250" Height="60" Command="{Binding PlayCommand}"/>
        <Button Content="🚗 АВТОМОБИЛИ" Width="250" Height="60" Command="{Binding CarsCommand}"/>
        <Button Content="🗺️ ТРАССЫ" Width="250" Height="60" Command="{Binding TracksCommand}"/>
        <Button Content="🏆 РЕКОРДЫ" Width="250" Height="60" Command="{Binding RecordsCommand}"/>
        <Button Content="❌ ВЫХОД" Width="250" Height="60" Command="{Binding ExitCommand}"/>
    </StackPanel>
    </Grid>
 </UserControl>
