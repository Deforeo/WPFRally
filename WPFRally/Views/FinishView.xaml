<UserControl x:Class="WPFRally.Views.FinishView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFRally.Views">
    <Grid Background="{StaticResource MenuBackground}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="ФИНИШ!" Style="{StaticResource TitleText}"/>
        <TextBlock Text="{Binding TimeText}" Style="{StaticResource NormalText}" FontSize="28" Foreground="Yellow"/>
        <TextBlock Text="{Binding BestRecordText}" Style="{StaticResource NormalText}"/>
        <Button Content="💾 СОХРАНИТЬ РЕКОРД" Command="{Binding SaveRecordCommand}" Width="300" Margin="10"/>
        <Button Content="🏠 ГЛАВНОЕ МЕНЮ" Command="{Binding BackToMenuCommand}" Width="300"/>
    </StackPanel>
        <ContentControl x:Name="OverlayContainer" Visibility="Collapsed"/>
    </Grid>
</UserControl>
