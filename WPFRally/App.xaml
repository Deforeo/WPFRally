<Application x:Class="WPFRally.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPFRally"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DropShadowEffect x:Key="ButtonShadow" 
                  Color="Black" 
                  Opacity="0.6" 
                  ShadowDepth="6" 
                  BlurRadius="8" 
                  Direction="315"/>
        <!-- Шрифты для текста-->
        <FontFamily x:Key="TitleFont">/Assets/Font/#NfS MW</FontFamily>
        <FontFamily x:Key="BodyFont">/Assets/Font/#Serpentin DG [Rus b</FontFamily>
        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D35400"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                      TextBlock.FontSize="{TemplateBinding FontSize}"
                                      TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F39C12"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.8" ShadowDepth="8" BlurRadius="12" Direction="315"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D35400"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="2" BlurRadius="4" Direction="315"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для вертикальной полосы прокрутки (тонкая, без стрелок) -->
        <!-- Стиль для вертикальной полосы (без стрелок, с закруглённым бегунком) -->
        <Style x:Key="CustomVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E67E22" 
                                                CornerRadius="2" 
                                                Width="4"
                                                Height="Auto"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ScrollViewer, использующий кастомную полосу -->
        <Style x:Key="CustomScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" 
                                            Content="{TemplateBinding Content}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                               Grid.Column="1"
                               Style="{StaticResource CustomVerticalScrollBar}"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Фон для меню -->
        <!-- Анимированный градиент (фиолетово-индиго) -->
        <LinearGradientBrush x:Key="AnimatedGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F0C29" Offset="0.0"/>
            <GradientStop Color="#302B63" Offset="0.5"/>
            <GradientStop Color="#24243E" Offset="1.0"/>
            <LinearGradientBrush.Transform>
                <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0"/>
            </LinearGradientBrush.Transform>
        </LinearGradientBrush>

        <!-- Стиль для всех окон (UserControl) – задаём фон -->
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource AnimatedGradient}"/>
        </Style>

        <SolidColorBrush x:Key="MenuBackground" Color="#2C3E50"/>
        <!-- Шрифты для текста-->
         
        <!-- Стиль для заголовков -->
        <Style TargetType="TextBlock" x:Key="TitleText">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F1C40F"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" 
Opacity="0.6" 
ShadowDepth="6" 
BlurRadius="8" 
Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маска для fade-out (плавное исчезновение краёв списка) -->
        <Style TargetType="ListBoxItem">
            <!-- Базовые настройки -->
            <Setter Property="Background" Value="#AA1A1A3A"/>
            <!-- полупрозрачный тёмно-фиолетовый -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Шаблон для скруглённых углов -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
            

            <!-- Триггеры для состояния и чередования цветов -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#1F618D"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="#AA1A1A3A"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#CC2A2A5A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A6A"/>
                    <Setter Property="BorderBrush" Value="#5DADE2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource CustomScrollViewer}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для обычного текста -->
        <Style TargetType="TextBlock" x:Key="NormalText">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#ECF0F1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" 
Opacity="0.6" 
ShadowDepth="6" 
BlurRadius="8" 
Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для текстовых полей (ввод рекорда) -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" 
Opacity="0.6" 
ShadowDepth="6" 
BlurRadius="8" 
Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>
       

        <!-- Стиль для заголовков колонок (GridViewColumnHeader) -->
        <!-- Стиль для ListView (прозрачный фон, убираем рамку) -->
        <!-- Стиль для ListView (прозрачный фон, без рамок) -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Стиль для элементов ListViewItem (без переопределения Template) -->
        <Style TargetType="ListViewItem">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Background" Value="#AA1A1A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#1F618D"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="#AA1A1A3A"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#CC2A2A5A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A6A"/>
                    <Setter Property="BorderBrush" Value="#5DADE2"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Стиль для заголовков колонок (GridViewColumnHeader) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#CC2A2A5A"/>
            <!-- тёмный фон -->
            <Setter Property="Foreground" Value="#F1C40F"/>
            <!-- золотистый текст -->
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <!-- отключаем клики и сортировку -->
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="8,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для разделителя колонок (не показываем) -->
        <Style TargetType="GridViewColumnHeader" x:Key="GripperStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        

    </Application.Resources>
</Application>
